@EndUserText.label: 'Access control - Inheritance'
@MappingRole: true
define role ZAC_JCRF_03_LOG_C460 {
    grant
        select
            on
                zcds_jcrf_31_log_c460
                    where
//                        inheriting conditions from entity zcds_jcrf_30_log_c460;
                        inherit ZAC_JCRF_01_LOG_C460
                        for grant select on zcds_jcrf_30_log_c460
                        or status = 'P';
                        
}